# Example environment variables for Tik be Tik.
# Never commit the real .env file.

DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Used in the upcoming Docker Compose stage.
POSTGRES_DB=tik_be_tik
POSTGRES_USER=tik_be_tik
POSTGRES_PASSWORD=replace-before-use
POSTGRES_HOST=db
POSTGRES_PORT=5432